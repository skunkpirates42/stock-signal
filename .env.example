# Copy to .env and fill in. The PoC runs fully offline with NONE of these set;
# they are only needed when wiring real data (Alpaca) and LLM synthesis (Anthropic).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live execution backend: 'local' (default, simulated fills) or 'alpaca' (submit real
# market orders to the paper account above). Only affects run_live.py.
BROKER=local
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=postgresql://localhost/papertrader
