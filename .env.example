# Loaded from the repository root; exported environment values take precedence.
# Alpaca orders are always paper=True. No live-money endpoint is supported.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
BROKER=local
ACCOUNT_NAMESPACE=local
# Live and replay defaults have separate overrides.
# DB_PATH=/absolute/path/papertrader.db
# BACKTEST_DB_PATH=/absolute/path/backtest.db
DASHBOARD_PORT=8000
BACKTEST_BARS=300
SESSION_POLICY=overnight
# Modeled round-trip spread bps, per-fill slippage bps, per-share fee per fill.
# Zero is an explicit frictionless scenario, not a realistic cost estimate.
SPREAD_BPS=0
SLIPPAGE_BPS=0
FEE_PER_SHARE=0
BAR_LATENESS_SECONDS=35
# Explanation only. Missing provider keys fall back to template text.
LLM_PROVIDER=template
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
LLM_MODEL=claude-haiku-4-5
